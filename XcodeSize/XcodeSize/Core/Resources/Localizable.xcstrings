    "Choose a specific developer-data folder, not a system or home directory.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a specific developer-data folder, not a system or home directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择具体的开发数据目录，不能将系统或用户根目录加入清理范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇明確的開發資料目錄，而非系統或個人專屬目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムやホームディレクトリではなく、個別の開発データフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이나 홈 디렉터리가 아닌 구체적인 개발 데이터 폴더를 선택하세요."
          }
        }
      },
      "generatesSymbol": false
    },
    "Choose the .build folder inside a Swift package. Add other locations as read-only folders.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the .build folder inside a Swift package. Add other locations as read-only folders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 Swift 包中的 .build 目录。其他位置可用只读方式添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 Swift 套件內的 .build 目錄。其他位置可新增為唯讀資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift パッケージ内の .build フォルダを選択してください。それ以外の場所は読み出し専用として追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift 패키지 안의 .build 폴더를 선택하세요. 다른 위치는 읽기 전용 폴더로 추가하세요."
          }
        }
      },
      "generatesSymbol": false
    },
    "Choose the folder's purpose to classify it correctly. Unrecognized data stays read-only. Adding a location never starts cleanup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder's purpose to classify it correctly. Unrecognized data stays read-only. Adding a location never starts cleanup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择目录的用途，帮助正确分类。未识别的内容始终只读；添加位置不会立即清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇目錄用途，以便正確分類。未辨識的資料保持唯讀。新增位置不會啟動清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正しく分類するためにフォルダの用途を選択してください。未識別のデータは読み出し専用です。場所を追加してもクリーンアップは始まりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "올바르게 분류할 수 있도록 폴더 용도를 선택하세요. 식별되지 않은 데이터는 읽기 전용입니다. 위치를 추가해도 정리가 시작되지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
