    "Results appear as the scan progresses. You can browse other categories while scanning.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results appear as the scan progresses. You can browse other categories while scanning."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描结果会逐步出现，可以继续浏览其他分类。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描結果會逐步顯示，掃描期間可繼續瀏覽其他分類。"
          }
