    "Review first. Moving to Trash does not immediately free space.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review first. Moving to Trash does not immediately free space."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先检查清单；移到废纸篓不代表空间立即释放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先檢查清單；移到垃圾桶不會立即釋放空間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず内容を確認してください。ゴミ箱への移動だけでは容量はすぐに解放されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 목록을 검토하세요. 휴지통으로 이동해도 공간이 즉시 확보되지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Review standard locations, custom folders, and inaccessible data. Totals include only identified, readable content.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review standard locations, custom folders, and inaccessible data. Totals include only identified, readable content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对标准位置、自定义目录与无法访问的数据。扫描结果只包含已识别、已读取的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核對標準位置、自訂資料夾與無法存取的資料。總量僅包含已辨識且可讀取的內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準場所、カスタムフォルダ、アクセスできないデータを確認します。合計には識別でき、読み取れた内容のみ含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 위치, 사용자 지정 폴더, 접근할 수 없는 데이터를 확인하세요. 합계에는 식별되고 읽을 수 있는 내용만 포함됩니다."
          }
        }
      },
      "generatesSymbol": false
    },
