      "generatesSymbol": false
    },
    "Xcode supports relative and custom build paths. Add their actual folders to include them in the scan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode supports relative and custom build paths. Add their actual folders to include them in the scan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 可以为项目指定相对或自定义构建路径。添加实际目录，才能把这些占用纳入统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 支援相對與自訂建置路徑。請新增實際目錄以納入掃描。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode は相対パスやカスタムビルドパスに対応しています。実際のフォルダを追加するとスキャンに含められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode는 상대 경로와 사용자 지정 빌드 경로를 지원합니다. 실제 폴더를 추가하면 스캔에 포함됩니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Xcode uses a relative location. Add the project's actual folder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode uses a relative location. Add the project's actual folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 配置使用相对目录；请添加对应项目的实际位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 使用相對位置。請新增專案的實際目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode は相対パスを使用しています。プロジェクトの実際のフォルダを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode가 상대 위치를 사용합니다. 프로젝트의 실제 폴더를 추가하세요."
          }
        }
      },
      "generatesSymbol": false
