    "Simulator operating systems and development components for different platforms. Runtimes are managed using Apple's simctl; mounted views are not counted twice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator operating systems and development components for different platforms. Runtimes are managed using Apple's simctl; mounted views are not counted twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为不同系统版本提供模拟器运行环境及开发组件。运行时通过 Apple 的 simctl 管理，挂载目录不重复统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提供不同平台的模擬器作業系統與開發元件。執行階段透過 Apple 的 simctl 管理；不重複計算掛載檢視。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プラットフォームのシミュレータ OS と開発コンポーネントです。ランタイムは Apple の simctl で管理し、マウントされた表示は重複計上しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랫폼별 시뮬레이터 운영 체제와 개발 구성 요소입니다. 런타임은 Apple의 simctl로 관리하며 마운트된 보기는 중복 집계하지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Simulator registration changed. Skipped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator registration changed. Skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器注册信息已变化，已跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器註冊資訊已變更，已略過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータの登録情報が変わったため、スキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 등록 정보가 변경되어 건너뛰었습니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Simulator removed. App sandboxes and local test data cannot be recovered automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator removed. App sandboxes and local test data cannot be recovered automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器设备已移除，App 沙盒和测试数据不可撤销"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除模擬器裝置。App 沙盒與本機測試資料無法自動復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータを削除しました。アプリのサンドボックスやローカルテストデータは自動では復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터를 제거했습니다. 앱 샌드박스와 로컬 테스트 데이터는 자동으로 복구할 수 없습니다."
          }
        }
      },
      "generatesSymbol": false
    },
