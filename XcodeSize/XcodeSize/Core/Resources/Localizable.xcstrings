    "simctl removal failed. Rescan to confirm the current state.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl removal failed. Rescan to confirm the current state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl 移除失败，请重新扫描确认状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl 移除失敗。請重新掃描以確認目前狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl による削除に失敗しました。再スキャンして現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl 제거에 실패했습니다. 다시 스캔하여 현재 상태를 확인하세요."
          }
        }
      },
      "generatesSymbol": false
    },
    "simctl reports runtime %@, but its backing storage is unreadable. Reported size: %@; excluded from the file-scan total.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl reports runtime %@, but its backing storage is unreadable. Reported size: %@; excluded from the file-scan total."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl 报告运行时 %@，原始存储不可读取；工具报告 %@，未加入文件扫描合计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl 回報執行階段 %@，但無法讀取原始儲存位置。回報大小：%@；未計入檔案掃描總量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl はランタイム %@ を報告していますが、実体のストレージを読み取れません。報告サイズ：%@。ファイルスキャンの合計から除外しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "simctl이 런타임 %@을(를) 보고했지만 실제 저장 공간을 읽을 수 없습니다. 보고된 크기: %@. 파일 스캔 합계에서 제외됩니다."
          }
        }
      },
      "generatesSymbol": false
    }
  },
  "version": "1.0"
