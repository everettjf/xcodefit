    "Adjust your search, choose another cleanup tier, or add a custom scan location.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust your search, choose another cleanup tier, or add a custom scan location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试调整搜索、切换清理档位，或添加自定义扫描位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請調整搜尋、切換清理層級，或新增自訂掃描位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索条件やクリーンアップレベルを変更するか、スキャン場所を追加してください。"
