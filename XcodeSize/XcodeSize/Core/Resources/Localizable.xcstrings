    "Xcode and simulators will not be forcibly closed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode and simulators will not be forcibly closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动退出 Xcode，也不会强制关闭模拟器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會強制結束 Xcode 或模擬器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode やシミュレータを強制終了することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode나 시뮬레이터를 강제로 종료하지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Xcode apps, bundled SDKs, and compiler toolchains. Internal folders are included in the installation size and are not counted or cleaned separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode apps, bundled SDKs, and compiler toolchains. Internal folders are included in the installation size and are not counted or cleaned separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 应用、内置 SDK 和编译工具链。子目录是安装包的组成部分，不能重复计入总量，也不单独清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode App、內建 SDK 與編譯工具鏈。內部目錄已計入安裝大小，不會重複計算或單獨清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode アプリ、内蔵 SDK、コンパイラツールチェーンです。内部フォルダはインストールサイズに含まれ、重複計上や個別のクリーンアップは行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 앱, 내장 SDK, 컴파일러 툴체인입니다. 내부 폴더는 설치 크기에 포함되며 중복 집계하거나 개별적으로 정리하지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Xcode or development tools are running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode or development tools are running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 或开发工具正在运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 或開發工具正在執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode または開発ツールが実行中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode 또는 개발 도구가 실행 중입니다."
          }
