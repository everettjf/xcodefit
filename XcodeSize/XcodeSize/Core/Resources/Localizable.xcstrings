    "Moved to Trash. Space is not freed until Trash is emptied.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to Trash. Space is not freed until Trash is emptied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移到废纸篓；清空前不会释放对应空间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移到垃圾桶；清空垃圾桶前不會釋放對應空間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に移動しました。ゴミ箱を空にするまで容量は解放されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동했습니다. 휴지통을 비울 때까지 공간이 확보되지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Moving files to Trash does not immediately free space. Files and development tools will be checked again before cleanup.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving files to Trash does not immediately free space. Files and development tools will be checked again before cleanup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓不会立即释放磁盘空间；清理前会再次检查文件和开发工具状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶不會立即釋放空間。清理前會再次檢查檔案與開發工具狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱への移動だけでは空き容量はすぐに増えません。クリーンアップ前にファイルと開発ツールを再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동해도 공간이 즉시 확보되지 않습니다. 정리 전에 파일과 개발 도구 상태를 다시 확인합니다."
          }
        }
      },
      "generatesSymbol": false
    },
