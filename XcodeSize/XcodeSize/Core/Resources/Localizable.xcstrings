    "Allocated sizes are deduplicated by file identity. APFS shared blocks, snapshots, and Trash affect actual space reclaimed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allocated sizes are deduplicated by file identity. APFS shared blocks, snapshots, and Trash affect actual space reclaimed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示已分配大小，并按文件身份去重。APFS 共享块、快照和废纸篓会影响实际释放量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示已配置大小，並依檔案識別資訊去重。APFS 共用區塊、快照與垃圾桶會影響實際釋放量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り当てサイズを表示し、ファイル識別情報で重複を除外します。APFS の共有ブロック、スナップショット、ゴミ箱が実際の解放容量に影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 식별 정보로 중복을 제외한 할당 크기를 표시합니다. APFS 공유 블록, 스냅샷, 휴지통이 실제 확보 공간에 영향을 줍니다."
          }
        }
      },
      "generatesSymbol": false
    },
    "Also choose archives, devices, and old tools.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also choose archives, devices, and old tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再选择归档、设备与旧环境"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進一步選擇封存檔、裝置與舊工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ、デバイス、古いツールも選択。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아카이브, 기기, 이전 도구도 선택하세요."
          }
        }
      },
      "generatesSymbol": false
    },
    "Also clean idle builds and dependencies.": {
      "extractionState": "manual",
