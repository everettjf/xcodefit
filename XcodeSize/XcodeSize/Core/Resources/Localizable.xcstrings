    "Swift Package Manager repositories, source working copies, manifests, and binary dependencies. Cleaning may require an internet connection; local changes in working copies are not automatically restored.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager repositories, source working copies, manifests, and binary dependencies. Cleaning may require an internet connection; local changes in working copies are not automatically restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager 的仓库、源码工作副本、manifest 和二进制依赖。清理后可能需要联网重新下载，工作副本中的本地修改不会自动恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager 的儲存庫、原始碼工作副本、套件資訊清單與二進位相依套件。清理後可能需要網路連線；工作副本中的本機修改不會自動還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager のリポジトリ、ソース作業コピー、マニフェスト、バイナリ依存関係です。クリーンアップ後はインターネット接続が必要な場合があります。作業コピーのローカル変更は自動では復元されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift Package Manager의 저장소, 소스 작업 사본, 매니페스트, 바이너리 종속성입니다. 정리 후 인터넷 연결이 필요할 수 있으며 작업 사본의 로컬 변경 사항은 자동으로 복구되지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
