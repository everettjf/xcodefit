    "Choose %@. Read-only locations are never cleaned.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose %@. Read-only locations are never cleaned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择%@。只读位置不会加入清理。"
          }
        },
        "zh-Hant": {
