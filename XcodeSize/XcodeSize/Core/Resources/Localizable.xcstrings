    "The command timed out. Its outcome is uncertain; rescan to confirm.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command timed out. Its outcome is uncertain; rescan to confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令超时，无法确定操作是否完成；请重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令逾時，無法確定結果；請重新掃描確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドがタイムアウトしました。結果が不明なため、再スキャンして確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 시간이 초과되었습니다. 결과가 불확실하므로 다시 스캔하여 확인하세요."
          }
        }
      },
      "generatesSymbol": false
    },
    "The latest 1,000 item results are kept. Files moved to Trash can be inspected and restored in Finder while they remain there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest 1,000 item results are kept. Files moved to Trash can be inspected and restored in Finder while they remain there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留最近 1,000 条逐项结果。记录的是操作事实，移到废纸篓后可在 Finder 中检查和还原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留最近 1,000 筆逐項結果。移到垃圾桶的檔案若仍在其中，可在 Finder 中檢查及還原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 1,000 件の項目別結果を保持します。ゴミ箱に移動したファイルは、そこに残っている間は Finder で確認・復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
