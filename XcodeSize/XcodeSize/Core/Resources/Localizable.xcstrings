    "Only attributable standard and custom locations are counted. Script outputs and relative build folders may be missing; add their actual locations.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only attributable standard and custom locations are counted. Script outputs and relative build folders may be missing; add their actual locations."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只统计可归属的标准目录和自定义位置。任意项目脚本输出、未添加的相对构建目录可能未纳入；可添加扫描位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅統計可歸屬的標準目錄與自訂位置。指令稿輸出及相對建置目錄可能遺漏；請新增實際位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連付けられる標準場所とカスタム場所のみ集計します。スクリプト出力や相対ビルドフォルダは含まれない場合があります。実際の場所を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소속을 식별할 수 있는 표준 위치와 사용자 지정 위치만 집계합니다. 스크립트 출력이나 상대 빌드 폴더는 빠질 수 있으므로 실제 위치를 추가하세요."
          }
        }
      },
      "generatesSymbol": false
    },
    "Only the symbolic link itself is counted. Its target is not followed or cleaned.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the symbolic link itself is counted. Its target is not followed or cleaned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符号链接只计链接本身，不跟随或清理目标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅計算符號連結本身，不跟隨或清理連結目標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンボリックリンク自体のみを計上します。リンク先はたどらず、クリーンアップもしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심볼릭 링크 자체만 집계합니다. 링크 대상을 탐색하거나 정리하지 않습니다."
          }
        }
      },
      "generatesSymbol": false
    },
